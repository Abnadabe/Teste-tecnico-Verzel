{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDir": "./",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    /* Adicione "@playwright/test" aqui junto com "node" */
    "types": ["node", "@playwright/test"]
  },
  /* Inclui o arquivo de configuração E toda a pasta tests */
  "include": ["playwright.config.ts", "tests/**/*"],
  /* Removemos "tests" daqui */
  "exclude": ["node_modules", "dist"]
}
